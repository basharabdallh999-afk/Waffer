@model SanaaOffers.MVC.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول إلى لوحة التحكم";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - وفّـر</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="login-page-wrapper">
        <div class="login-form-container">
            <div class="login-card">
                <div class="text-center mb-4">
                    <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                        <span style="font-size: 30px; font-weight: 900; color: #B3241C;">Waffer</span>
                        <span style="background-color: #B3241C; color: #fff; font-size: 22px; font-weight: 800; padding: 2px 14px; border-radius: 12px;">وفر</span>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">تسجيل الدخول إلى لوحة التحكم</h4>
                    <p class="text-muted small">أدخل بيانات حسابك للوصول إلى إدارة المنصة</p>

                    <!-- Quick Demo Fill -->
                    <button type="button" class="btn btn-sm rounded-pill px-3 fw-bold" 
                            style="background-color: #FDF2F2; color: #B3241C; border: 1px solid #FECACA;"
                            onclick="fillAdminDemo()">
                        <i class="bi bi-shield-lock-fill me-1"></i> تعبئة تجريبية سريعة (حساب المدير)
                    </button>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 px-3 rounded-3 mb-3 d-flex align-items-center gap-2" style="font-size:13.5px;">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@ViewData.ModelState[string.Empty]?.Errors[0].ErrorMessage</span>
                    </div>
                }

                <form method="post" asp-action="Login">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-bold small text-dark">البريد الإلكتروني / اسم المستخدم</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-start-0"><i class="bi bi-envelope text-muted"></i></span>
                            <input asp-for="Username" id="loginUsername" class="form-control" placeholder="admin@waffer.com" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-bold small text-dark">كلمة المرور</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-start-0"><i class="bi bi-lock text-muted"></i></span>
                            <input asp-for="Password" id="loginPassword" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn w-100 py-2 fw-bold rounded-3 shadow-sm mb-3 text-white" style="background-color: #B3241C;">
                        <i class="bi bi-box-arrow-in-left me-1"></i> دخول إلى النظام
                    </button>

                    <div class="text-center">
                        <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-right me-1"></i> العودة للموقع الرئيسي
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="login-side-visual">
            <div class="d-flex align-items-center gap-3">
                <div class="brand-logo" style="width:44px;height:44px;font-size:20px;">
                    <i class="bi bi-tag-fill"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">منصة وفّـر</h4>
                    <small class="text-white-50">نظام إدارة عروض وتخفيضات صنعاء</small>
                </div>
            </div>

            <div>
                <h2 class="fw-bold mb-3">لوحة تحكم إحصائية وإدارية متكاملة</h2>
                <p class="text-white-50" style="font-size:15px;line-height:1.8;">
                    إدارة شاملة للتجار والمتاجر، نشر العروض الترويجية والصفقات الخاطفة، تنظيم التصنيفات، ومتابعة إحصائيات ونمو المنصة لحظة بلحظة.
                </p>
                <div class="d-flex gap-3 mt-4">
                    <div class="p-3 rounded-3 bg-white bg-opacity-10 text-center flex-fill">
                        <h4 class="fw-bold mb-0 text-warning">100%</h4>
                        <small class="text-white-50">تغطية شاملة</small>
                    </div>
                    <div class="p-3 rounded-3 bg-white bg-opacity-10 text-center flex-fill">
                        <h4 class="fw-bold mb-0 text-info">RTL</h4>
                        <small class="text-white-50">واجهة عربية</small>
                    </div>
                    <div class="p-3 rounded-3 bg-white bg-opacity-10 text-center flex-fill">
                        <h4 class="fw-bold mb-0 text-success">Live</h4>
                        <small class="text-white-50">إحصائيات فورية</small>
                    </div>
                </div>
            </div>

            <div class="text-white-50 small">
                &copy; @DateTime.Now.Year - وفّـر (Waffer Sanaa Offers)
            </div>
    </div>

    <script>
        function fillAdminDemo() {
            document.getElementById('loginUsername').value = 'admin@waffer.com';
            document.getElementById('loginPassword').value = '123456';
        }
    </script>
</body>
</html>