@model SanaaOffers.MVC.ViewModels.MerchantFormViewModel
@{
    ViewData["Title"] = "إضافة متجر / تاجر جديد";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-plus-circle-fill text-danger me-2"></i> إضافة متجر جديد</h3>
        <p class="text-muted mb-0">تسجيل بيانات متجر تجاري وربطه بحساب مستخدم في صنعاء</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-light-custom">
            <i class="bi bi-arrow-right"></i> العودة للقائمة
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="main-card">
            <div class="main-card-header">
                <h5 class="main-card-title"><i class="bi bi-shop text-danger"></i> بيانات المتجر</h5>
            </div>
            <div class="main-card-body p-4">
                <form method="post" asp-action="Create">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="StoreName" class="form-label fw-bold text-dark"></label> <span class="text-danger">*</span>
                            <input asp-for="StoreName" class="form-control" placeholder="مثال: سوبرماركت الهدى" />
                            <span asp-validation-for="StoreName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserId" class="form-label fw-bold text-dark"></label> <span class="text-danger">*</span>
                            <select asp-for="UserId" asp-items="Model.UserList" class="form-select">
                                <option value="">-- اختر المستخدم المالك للمتجر --</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Phone" class="form-control" placeholder="مثال: 01-445566 أو 771234567" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Address" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Address" class="form-control" placeholder="مثال: صنعاء - شارع حدة - مقابل مركز الكميم" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Latitude" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Latitude" class="form-control" type="number" step="0.000001" placeholder="15.3324" />
                            <span asp-validation-for="Latitude" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Longitude" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Longitude" class="form-control" type="number" step="0.000001" placeholder="44.1856" />
                            <span asp-validation-for="Longitude" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="IsApproved" id="isApprovedSwitch" checked>
                                <label class="form-check-label fw-bold text-dark" for="isApprovedSwitch">اعتماد وتفعيل المتجر مباشرة</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end border-top pt-4 mt-4">
                        <a asp-action="Index" class="btn btn-light px-4 fw-bold">إلغاء</a>
                        <button type="submit" class="btn btn-primary-custom px-4">
                            <i class="bi bi-check2-circle"></i> حفظ وإضافة المتجر
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}