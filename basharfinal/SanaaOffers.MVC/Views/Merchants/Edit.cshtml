@model SanaaOffers.MVC.ViewModels.MerchantFormViewModel
@{
    ViewData["Title"] = "تعديل المتجر: " + Model.StoreName;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-pencil-square text-primary me-2"></i> تعديل بيانات المتجر</h3>
        <p class="text-muted mb-0">تحديث معلومات المتجر، العنوان، الموقع الجغرافي أو المالك</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-light-custom">
            <i class="bi bi-arrow-right"></i> العودة للقائمة
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="main-card">
            <div class="main-card-header">
                <h5 class="main-card-title"><i class="bi bi-shop text-danger"></i> نموذج تعديل المتجر</h5>
            </div>
            <div class="main-card-body p-4">
                <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="StoreName" class="form-label fw-bold text-dark"></label> <span class="text-danger">*</span>
                            <input asp-for="StoreName" class="form-control" />
                            <span asp-validation-for="StoreName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserId" class="form-label fw-bold text-dark"></label> <span class="text-danger">*</span>
                            <select asp-for="UserId" asp-items="Model.UserList" class="form-select"></select>
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Address" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Latitude" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Latitude" class="form-control" type="number" step="0.000001" />
                            <span asp-validation-for="Latitude" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Longitude" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Longitude" class="form-control" type="number" step="0.000001" />
                            <span asp-validation-for="Longitude" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="IsApproved" id="isApprovedSwitch">
                                <label class="form-check-label fw-bold text-dark" for="isApprovedSwitch">حالة الاعتماد والتفعيل</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end border-top pt-4 mt-4">
                        <a asp-action="Index" class="btn btn-light px-4 fw-bold">إلغاء</a>
                        <button type="submit" class="btn btn-primary-custom px-4">
                            <i class="bi bi-save"></i> حفظ التعديلات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}