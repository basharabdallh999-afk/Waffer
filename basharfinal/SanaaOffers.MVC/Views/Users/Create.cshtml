@model SanaaOffers.MVC.ViewModels.UserFormViewModel
@using SanaaOffersApi.Domain.Entities
@{
    ViewData["Title"] = "إضافة مستخدم جديد";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-person-plus-fill text-danger me-2"></i> إضافة مستخدم جديد</h3>
        <p class="text-muted mb-0">تسجيل حساب مدير، تاجر أو عميل جديد في المنصة</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-light-custom">
            <i class="bi bi-arrow-right"></i> العودة للقائمة
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="main-card">
            <div class="main-card-header">
                <h5 class="main-card-title"><i class="bi bi-person-circle text-danger"></i> بيانات الحساب</h5>
            </div>
            <div class="main-card-body p-4">
                <form method="post" asp-action="Create">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="FullName" class="form-label fw-bold text-dark"></label> <span class="text-danger">*</span>
                            <input asp-for="FullName" class="form-control" placeholder="الاسم الكامل ثلاثي" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold text-dark"></label> <span class="text-danger">*</span>
                            <input asp-for="Email" class="form-control" type="email" placeholder="example@waffer.ye" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Phone" class="form-control" placeholder="771234567" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Role" class="form-label fw-bold text-dark"></label> <span class="text-danger">*</span>
                            <select asp-for="Role" class="form-select">
                                <option value="@UserRole.Consumer">عميل (Consumer)</option>
                                <option value="@UserRole.Merchant">تاجر / صاحب متجر (Merchant)</option>
                                <option value="@UserRole.Admin">مدير ومسؤول نظام (Admin)</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-bold text-dark"></label> <span class="text-danger">*</span>
                            <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold text-dark"></label> <span class="text-danger">*</span>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end border-top pt-4 mt-4">
                        <a asp-action="Index" class="btn btn-light px-4 fw-bold">إلغاء</a>
                        <button type="submit" class="btn btn-primary-custom px-4">
                            <i class="bi bi-check2-circle"></i> إنشاء الحساب
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}