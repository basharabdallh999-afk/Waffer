@model SanaaOffersApi.Domain.Entities.User
@{
    ViewData["Title"] = "حذف المستخدم: " + Model.FullName;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1 text-danger"><i class="bi bi-exclamation-octagon-fill me-2"></i> تأكيد حذف المستخدم</h3>
        <p class="text-muted mb-0">يرجى مراجعة تفاصيل الحساب قبل اتخاذ القرار النهائي بالحذف</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-light-custom">
            <i class="bi bi-arrow-right"></i> العودة للقائمة
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="main-card border-danger border-2">
            <div class="main-card-body p-4 text-center">
                <div class="delete-icon-pulse mb-3">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">هل أنت متأكد من حذف الحساب "@Model.FullName"؟</h4>
                <p class="text-muted mb-4">سيتم حذف بيانات الحساب والمتاجر والعروض التابعة له نهائياً:</p>

                <div class="p-3 bg-light rounded-3 text-start mb-4">
                    <div class="mb-2"><strong>الاسم:</strong> @Model.FullName</div>
                    <div class="mb-2"><strong>البريد الإلكتروني:</strong> @Model.Email</div>
                    <div class="mb-2"><strong>نوع الحساب:</strong> @Model.Role</div>
                    <div><strong>عدد المتاجر المرتبطة:</strong> @(Model.Merchants?.Count ?? 0) متجر</div>
                </div>

                <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-3 justify-content-center">
                        <a asp-action="Index" class="btn btn-light px-4 fw-bold">إلغاء</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            <i class="bi bi-trash3-fill me-1"></i> تأكيد الحذف النهائي
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>