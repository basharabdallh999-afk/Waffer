@model SanaaOffers.MVC.ViewModels.CategoryFormViewModel
@{
    ViewData["Title"] = "إضافة تصنيف جديد";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-plus-circle-fill text-danger me-2"></i> إضافة تصنيف جديد</h3>
        <p class="text-muted mb-0">أدخل تفاصيل التصنيف الجديد وأيقونته التوضيحية</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-light-custom">
            <i class="bi bi-arrow-right"></i> العودة للقائمة
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="main-card">
            <div class="main-card-header">
                <h5 class="main-card-title"><i class="bi bi-grid text-danger"></i> نموذج بيانات التصنيف</h5>
            </div>
            <div class="main-card-body p-4">
                <form method="post" asp-action="Create">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold text-dark"></label> <span class="text-danger">*</span>
                        <input asp-for="Name" class="form-control" placeholder="مثال: مطاعم ومأكولات" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold text-dark"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="نبذة مختصرة عن هذا التصنيف والمنتجات التي يشملها..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Icon" class="form-label fw-bold text-dark"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-palette"></i></span>
                            <input asp-for="Icon" class="form-control" placeholder="bi-cart4 أو bi-laptop أو bi-cup-hot" />
                        </div>
                        <small class="text-muted d-block mt-1">يمكنك استخدام أي كلاس من مكتبة Bootstrap Icons (مثل: bi-laptop, bi-cart4, bi-cup-hot, bi-bag, bi-heart-pulse)</small>
                        <span asp-validation-for="Icon" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end border-top pt-3">
                        <a asp-action="Index" class="btn btn-light px-4 fw-bold">إلغاء</a>
                        <button type="submit" class="btn btn-primary-custom px-4">
                            <i class="bi bi-check2-circle"></i> حفظ وإضافة التصنيف
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}