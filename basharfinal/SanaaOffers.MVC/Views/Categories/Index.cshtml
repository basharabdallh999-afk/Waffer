@model IEnumerable<SanaaOffersApi.Domain.Entities.Category>
@{
    ViewData["Title"] = "إدارة التصنيفات";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-grid-3x3-gap-fill text-danger me-2"></i> إدارة التصنيفات</h3>
        <p class="text-muted mb-0">عرض وإدارة كافة تصنيفات العروض المتاحة في المنصة</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary-custom">
            <i class="bi bi-plus-lg"></i> إضافة تصنيف جديد
        </a>
    </div>
</div>

<div class="main-card">
    <div class="main-card-header">
        <h5 class="main-card-title"><i class="bi bi-list-ul text-danger"></i> قائمة التصنيفات</h5>
    </div>
    <div class="table-responsive p-3">
        <table id="categoriesTable" class="table table-hover w-100">
            <thead>
                <tr>
                    <th style="width: 60px;">#</th>
                    <th>الأيقونة</th>
                    <th>اسم التصنيف</th>
                    <th>الوصف</th>
                    <th>عدد العروض</th>
                    <th style="width: 140px;">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="fw-bold text-muted">@item.Id</span></td>
                        <td>
                            <div class="stat-icon red" style="width:38px;height:38px;font-size:18px;">
                                <i class="bi @(string.IsNullOrEmpty(item.Icon) ? "bi-tag" : item.Icon)"></i>
                            </div>
                        </td>
                        <td><span class="fw-bold text-dark fs-6">@item.Name</span></td>
                        <td><span class="text-muted">@(item.Description ?? "لا يوجد وصف")</span></td>
                        <td>
                            <span class="badge bg-light text-dark border px-3 py-2">
                                <i class="bi bi-tags-fill text-danger me-1"></i> @(item.Offers?.Count ?? 0) عرض
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light" title="التفاصيل">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary" title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger" title="الحذف">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        $('#categoriesTable').DataTable({
            responsive: true,
            order: [[0, 'asc']]
        });
    });
</script>
}