@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName") ?? "مدير النظام";
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole") ?? "مسؤول المنصة";
    var activePage = ViewData["ActivePage"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - وفر | عروض صنعاء</title>
    
    <!-- Google Fonts: Cairo & Tajawal -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- DataTables Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="admin-wrapper">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
            <div class="d-flex align-items-center gap-2">
                <span style="font-size: 22px; font-weight: 900; color: #fff; letter-spacing: -0.5px;">Waffer</span>
                <span style="background-color: #B3241C; color: #fff; font-size: 16px; font-weight: 800; padding: 2px 10px; border-radius: 8px;">وفر</span>
            </div>
        </a>

        <!-- Navigation -->
        <nav class="sidebar-nav">
            <span class="nav-section-label">الرئيسية والتحكم</span>

            <a class="sidebar-link @(activePage == "Dashboard" ? "active" : "")"
               asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2-fill"></i>
                لوحة التحكم الإحصائية
            </a>

            <a class="sidebar-link @(activePage == "Home" ? "active" : "")"
               asp-controller="Home" asp-action="Index" target="_blank">
                <i class="bi bi-globe2"></i>
                بوابة الزوار (الموقع العام)
                <i class="bi bi-box-arrow-up-right ms-auto text-muted" style="font-size:12px;"></i>
            </a>

            <span class="nav-section-label">إدارة المنظومة</span>

            <a class="sidebar-link @(activePage == "Offers" ? "active" : "")"
               asp-controller="Offers" asp-action="Index">
                <i class="bi bi-tags-fill"></i>
                إدارة العروض والتخفيضات
            </a>

            <a class="sidebar-link @(activePage == "Merchants" ? "active" : "")"
               asp-controller="Merchants" asp-action="Index">
                <i class="bi bi-shop"></i>
                إدارة المتاجر والتجار
            </a>

            <a class="sidebar-link @(activePage == "Categories" ? "active" : "")"
               asp-controller="Categories" asp-action="Index">
                <i class="bi bi-grid-3x3-gap-fill"></i>
                إدارة التصنيفات
            </a>

            <a class="sidebar-link @(activePage == "Users" ? "active" : "")"
               asp-controller="Users" asp-action="Index">
                <i class="bi bi-people-fill"></i>
                إدارة العملاء والمستخدمين
            </a>

            <span class="nav-section-label">روابط سريعة</span>

            <a class="sidebar-link" asp-controller="Offers" asp-action="Create">
                <i class="bi bi-plus-circle-fill text-danger"></i>
                إضافة عرض جديد
            </a>

            <a class="sidebar-link" asp-controller="Merchants" asp-action="Create">
                <i class="bi bi-building-add text-primary"></i>
                إضافة تاجر جديد
            </a>
        </nav>

        <!-- User profile & Logout -->
        <div class="sidebar-footer">
            <a class="sidebar-link text-danger" asp-controller="Auth" asp-action="Logout">
                <i class="bi bi-box-arrow-right"></i>
                تسجيل الخروج
            </a>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="main-content">

        <!-- Top Bar -->
        <header class="topbar">
            <div class="topbar-right d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-light d-md-none" id="sidebarToggle" type="button">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div class="topbar-search">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="بحث عام سريع في المنصة..." id="globalSearchInput" />
                </div>
            </div>

            <div class="topbar-left">
                <a href="tel:779888892" class="btn btn-outline-warning btn-sm px-3 fw-bold d-none d-md-inline-flex align-items-center gap-1">
                    <i class="bi bi-headset"></i> الدعم: 779888892
                </a>
                <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline-danger btn-sm px-3 fw-bold d-none d-sm-inline-flex align-items-center gap-1">
                    <i class="bi bi-eye"></i> معاينة بوابة الزوار
                </a>

                <div class="user-pill">
                    <div class="user-avatar">
                        @(userName.Length > 0 ? userName.Substring(0, 1) : "م")
                    </div>
                    <div class="user-info">
                        <span class="user-name">@userName</span>
                        <span class="user-role">@userRole</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- Alerts -->
        <div class="page-container pb-0">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show custom-alert shadow-sm" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show custom-alert shadow-sm" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                </div>
            }
        </div>

        <!-- Page Content -->
        <main class="page-container">
            @RenderBody()
        </main>
    </div>
</div>

<!-- GLOBAL BOOTSTRAP DELETE MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إلغاء"></button>
            </div>
            <div class="modal-body text-center pt-0 px-4">
                <div class="delete-icon-pulse mb-3">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <h5 class="fw-bold mb-2 text-dark" id="deleteModalLabel">تأكيد عملية الحذف</h5>
                <p class="text-muted mb-0" style="font-size:14.5px;">
                    هل أنت متأكد تماماً من رغبتك في حذف <strong id="deleteItemName" class="text-danger">هذا العنصر</strong>؟
                    <br /><small class="text-secondary">لا يمكن التراجع عن هذه العملية بعد إتمامها.</small>
                </p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pb-4">
                <button type="button" class="btn btn-light px-4 fw-bold rounded-3" data-bs-dismiss="modal">
                    إلغاء الأمر
                </button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4 fw-bold rounded-3 shadow-sm">
                        <i class="bi bi-trash3-fill me-1"></i> نعم، حذف نهائي
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Core Scripts -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Global Confirmation Delete Modal Trigger
    function confirmDelete(url, name) {
        document.getElementById('deleteItemName').textContent = name ? `"${name}"` : 'هذا العنصر';
        document.getElementById('deleteForm').action = url;
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    // Default Arabic language settings for DataTables
    if ($.fn.dataTable) {
        $.extend(true, $.fn.dataTable.defaults, {
            language: {
                search: "بحث سريع:",
                lengthMenu: "عرض _MENU_ عناصر",
                info: "عرض من _START_ إلى _END_ من أصل _TOTAL_ عنصر",
                infoEmpty: "لا توجد سجلات متاحة",
                infoFiltered: "(تمت التصفية من إجمالي _MAX_ عنصر)",
                zeroRecords: "لم يتم العثور على أي نتائج مطابقة",
                paginate: {
                    first: "الأول",
                    previous: "السابق",
                    next: "التالي",
                    last: "الأخير"
                }
            }
        });
    }

    // Mobile sidebar toggle
    document.getElementById('sidebarToggle')?.addEventListener('click', function() {
        document.querySelector('.sidebar')?.classList.toggle('show-mobile');
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>