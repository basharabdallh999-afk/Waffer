<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - وفّـر | أفضل عروض وتخفيضات صنعاء</title>
    
    <!-- Google Fonts: Cairo & Tajawal -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #F8F8F8;
            color: #1E1E1E;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Modern Visitor Topbar */
        .modern-topbar {
            background-color: #1A1A1A;
            color: #94A3B8;
            font-size: 13px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Modern Navbar */
        .modern-navbar {
            background: #FFFFFF;
            padding: 14px 0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            position: sticky;
            top: 0;
            z-index: 1040;
        }

        .brand-container {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-text-en {
            font-size: 26px;
            font-weight: 900;
            color: #B3241C;
            letter-spacing: -0.5px;
        }

        .brand-badge-ar {
            background-color: #B3241C;
            color: #FFFFFF;
            font-size: 20px;
            font-weight: 800;
            padding: 2px 14px;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(179, 36, 28, 0.25);
        }

        .brand-sub {
            font-size: 11px;
            color: #64748B;
            font-weight: 600;
            margin-right: 4px;
        }

        .nav-link-modern {
            color: #475569;
            font-weight: 700;
            font-size: 14.5px;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 12px;
            transition: all 0.2s ease;
        }

        .nav-link-modern:hover, .nav-link-modern.active {
            color: #B3241C;
            background-color: #FDF2F2;
        }

        .btn-portal-action {
            background-color: #B3241C;
            color: #FFFFFF;
            font-weight: 700;
            font-size: 13.5px;
            padding: 8px 20px;
            border-radius: 12px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px rgba(179, 36, 28, 0.25);
        }

        .btn-portal-action:hover {
            background-color: #8B1812;
            color: #FFFFFF;
            transform: translateY(-1px);
        }

        /* Modern Footer */
        .modern-footer {
            background-color: #1A1A1A;
            color: #94A3B8;
            padding: 55px 0 25px;
            margin-top: auto;
        }

        .footer-heading {
            color: #FFFFFF;
            font-weight: 800;
            font-size: 16px;
            margin-bottom: 18px;
        }

        .footer-link {
            color: #94A3B8;
            text-decoration: none;
            font-size: 13.5px;
            transition: color 0.2s ease;
            display: inline-block;
            margin-bottom: 8px;
        }

        .footer-link:hover {
            color: #FFFFFF;
        }

        .hotline-badge {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 14px;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 14px;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- TOP BAR -->
    <div class="modern-topbar">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-geo-alt-fill text-danger me-1"></i> العاصمة صنعاء، الجمهورية اليمنية</span>
                <span class="text-white-50">|</span>
                <span><i class="bi bi-patch-check-fill text-success me-1"></i> المنصة الرسمية المعتمدة للعروض اليومية</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="tel:779888892" class="text-white text-decoration-none fw-bold small">
                    <i class="bi bi-telephone-fill text-danger me-1"></i> خدمة العملاء: <span class="text-warning">779888892</span>
                </a>
                <a href="https://wa.me/967779888892" target="_blank" class="text-success text-decoration-none fw-bold small">
                    <i class="bi bi-whatsapp"></i> واتساب
                </a>
            </div>
        </div>
    </div>

    <!-- MAIN NAVBAR -->
    <header class="modern-navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <!-- Brand matching Flutter App -->
            <a asp-controller="Home" asp-action="Index" class="brand-container">
                <span class="brand-text-en">Waffer</span>
                <span class="brand-badge-ar">وفر</span>
                <span class="brand-sub d-none d-sm-inline">• أفضل العروض في صنعاء</span>
            </a>

            <!-- Essential Navigation Links -->
            <nav class="d-none d-md-flex align-items-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="nav-link-modern active">الرئيسية</a>
                <a href="#offers-section" class="nav-link-modern">العروض والتخفيضات</a>
                <a href="#categories-section" class="nav-link-modern">التصنيفات</a>
                <a href="#merchants-section" class="nav-link-modern">المتاجر المعتمدة</a>
            </nav>

            <!-- Dashboard Button -->
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn-portal-action">
                    <i class="bi bi-speedometer2"></i>
                    <span>لوحة التحكم</span>
                </a>
            </div>
        </div>
    </header>

    <!-- CONTENT BODY -->
    <main>
        @RenderBody()
    </main>

    <!-- MODERN FOOTER -->
    <footer class="modern-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Col 1: Platform Overview -->
                <div class="col-lg-5 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-text-en text-white">Waffer</span>
                        <span class="brand-badge-ar">وفر</span>
                    </div>
                    <p class="small text-secondary" style="line-height: 1.8; max-width: 440px;">
                        بوابتك الرقمية الذكية لاستكشاف ومتابعة أحدث العروض والصفقات والتخفيضات الحصرية من كبرى المولات والسوبر ماركت والمتاجر في العاصمة صنعاء.
                    </p>
                    <div class="small text-secondary mt-2">
                        <i class="bi bi-mortarboard-fill text-danger me-1"></i> مشروع التدريب الميداني - قسم تكنولوجيا المعلومات - جامعة الحكمة.
                    </div>
                </div>

                <!-- Col 2: Navigation Links -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-heading">روابط المنصة</h6>
                    <div class="d-flex flex-column">
                        <a href="#offers-section" class="footer-link">أحدث العروض المنشورة</a>
                        <a href="#categories-section" class="footer-link">الأقسام والتصنيفات</a>
                        <a href="#merchants-section" class="footer-link">شبكة المتاجر في صنعاء</a>
                        <a asp-controller="Dashboard" asp-action="Index" class="footer-link">دخول الإدارة والإحصائيات</a>
                    </div>
                </div>

                <!-- Col 3: Support Hotline -->
                <div class="col-lg-4 col-md-12">
                    <h6 class="footer-heading">الدعم والمساعدة</h6>
                    <div class="hotline-badge mb-3">
                        <i class="bi bi-headset fs-2 text-danger"></i>
                        <div>
                            <div class="small text-secondary">الخط الساخن المباشر في صنعاء:</div>
                            <a href="tel:779888892" class="fs-4 fw-bold text-warning text-decoration-none">779888892</a>
                        </div>
                    </div>
                    <div class="small text-secondary">
                        <i class="bi bi-clock-history me-1"></i> خدمة متوفرة يومياً من 8:00 صباحاً حتى 10:00 مساءً.
                    </div>
                </div>
            </div>

            <hr style="border-color: rgba(255, 255, 255, 0.1);">
            <div class="d-flex flex-wrap justify-content-between align-items-center small text-secondary pt-2">
                <div>&copy; @DateTime.Now.Year منصة وفر (Waffer) - عروض صنعاء. كافة الحقوق محفوظة.</div>
                <div>خدمة العملاء: <a href="tel:779888892" class="text-warning text-decoration-none fw-bold">779888892</a></div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
