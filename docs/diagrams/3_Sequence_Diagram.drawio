        <!-- Title -->
        <mxCell id="title_seq" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;مخطط التتابع: دورة تسجيل المتجر والتحقق والاعتماد من الإدارة (Sequence Diagram)&lt;/b&gt;&lt;br&gt;Merchant Registration, Pending Approval, and Admin Verification Lifecycle" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#1E293B;fontColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="810" height="50" as="geometry" />
        </mxCell>

        <!-- Lifelines (Actors & Objects) -->
