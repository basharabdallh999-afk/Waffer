        <mxCell id="ll_merchant" value="التاجر&#xa;(Merchant)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="100" height="680" as="geometry" />
        </mxCell>

        <!-- 2. Flutter Mobile App -->
        <mxCell id="ll_app" value="تطبيق الموبايل&#xa;(Flutter App)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0369A1;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="230" y="90" width="110" height="680" as="geometry" />
