        <mxCell id="seq_title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;مخطط التتابع القياسي: دورة تسجيل المتجر والتوثيق ونشر العروض&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #475569;&quot;&gt;UML Sequence: Merchant Registration ◄► Admin Approval ◄► Offer Publishing&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#F8FAFC;fontColor=#0F172A;strokeColor=#CBD5E1;" vertex="1" parent="1">
