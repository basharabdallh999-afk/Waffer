        <!-- Step 14: DB confirm -->
        <mxCell id="msg_14" value="14: تم اعتماد وتوثيق المتجر بنجاح" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#F59E0B;fontColor=#92400E;" edge="1" parent="1" source="ll_db" target="ll_mvc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="640" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 15: Admin alert -->
        <mxCell id="msg_15" value="15: إشعار نجاح التوثيق وتحويل المتجر لـ &quot;معتمد وموثق&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#EF4444;fontColor=#991B1B;" edge="1" parent="1" source="ll_mvc" target="ll_admin">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="665" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 16: Merchant unlocked -->
        <mxCell id="msg_16" value="16: فتح تطبيق الموبايل واستعلام الحالة: IsApproved=true ◄ تفعيل صلاحية نشر العروض!" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#10B981;fontColor=#065F46;strokeWidth=2;" edge="1" parent="1" source="ll_merchant" target="ll_app">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
