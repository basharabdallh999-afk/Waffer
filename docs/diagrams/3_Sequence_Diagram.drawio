          <mxGeometry x="410" y="90" width="120" height="680" as="geometry" />
        </mxCell>

        <!-- 4. Database -->
        <mxCell id="ll_db" value="قاعدة البيانات&#xa;(Database / EF)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="120" height="680" as="geometry" />
        </mxCell>

        <!-- 5. Admin Portal MVC -->
        <mxCell id="ll_mvc" value="لوحة تحكم الويب&#xa;(MVC Dashboard)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E40AF;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="790" y="90" width="130" height="680" as="geometry" />
        </mxCell>

        <!-- 6. Admin Actor -->
        <mxCell id="ll_admin" value="مدير النظام&#xa;(System Admin)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="990" y="90" width="110" height="680" as="geometry" />
        </mxCell>

        <!-- Messages Sequence -->
        <!-- Step 1: Merchant submits registration -->
        <mxCell id="msg_1" value="1: إدخال بيانات المتجر والنقر على تسجيل" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#10B981;fontColor=#065F46;strokeWidth=2;" edge="1" parent="1" source="ll_merchant" target="ll_app">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="150" as="offset" />
            <Array as="points">
              <mxPoint x="190" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 2: App to Web API -->
        <mxCell id="msg_2" value="2: POST /api/auth/register-merchant (StoreName, Email, Pass)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0284C7;fontColor=#0369A1;strokeWidth=2;" edge="1" parent="1" source="ll_app" target="ll_api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="195" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 3: Self-validation & hash -->
        <mxCell id="msg_3" value="3: التحقق من صحة البيانات وتشفير كلمة المرور" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#7C3AED;fontColor=#5B21B6;" edge="1" parent="1" source="ll_api" target="ll_api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="500" y="225" />
              <mxPoint x="500" y="245" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 4: Save to DB as Pending -->
        <mxCell id="msg_4" value="4: INSERT INTO Stores (IsApproved=false, Status='Pending')" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#7C3AED;fontColor=#5B21B6;strokeWidth=2;" edge="1" parent="1" source="ll_api" target="ll_db">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="275" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 5: DB confirmation -->
        <mxCell id="msg_5" value="5: تم الحفظ بنجاح (Record Created)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#F59E0B;fontColor=#92400E;" edge="1" parent="1" source="ll_db" target="ll_api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="305" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 6: API returns 201 -->
        <mxCell id="msg_6" value="6: HTTP 201 Created (&quot;طلبك قيد المراجعة والتوثيق&quot;)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#0284C7;fontColor=#0369A1;" edge="1" parent="1" source="ll_api" target="ll_app">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="335" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 7: App displays popup to merchant -->
        <mxCell id="msg_7" value="7: عرض نافذة منبثقة تفاعلية: &quot;تم استلام الطلب وبانتظار التوثيق&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#10B981;fontColor=#065F46;" edge="1" parent="1" source="ll_app" target="ll_merchant">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="365" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Divider / Step Transition -->
        <mxCell id="divider_1" value="مرحلة مراجعة وتوثيق المدير من لوحة تحكم الويب (Admin Review &amp; Approval)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="395" width="540" height="25" as="geometry" />
        </mxCell>

        <!-- Step 8: Admin opens portal -->
        <mxCell id="msg_8" value="8: تسجيل دخول المشرف وفتح لوحة التحكم" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#EF4444;fontColor=#991B1B;strokeWidth=2;" edge="1" parent="1" source="ll_admin" target="ll_mvc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="445" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 9: Portal queries DB -->
        <mxCell id="msg_9" value="9: استعلام المتاجر المعلقة: SELECT WHERE IsApproved=false" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#2563EB;fontColor=#1E40AF;strokeWidth=2;" edge="1" parent="1" source="ll_mvc" target="ll_db">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="475" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 10: DB returns pending list -->
        <mxCell id="msg_10" value="10: إرجاع قائمة المتاجر الجديدة بانتظار الاعتماد" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#F59E0B;fontColor=#92400E;" edge="1" parent="1" source="ll_db" target="ll_mvc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="505" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 11: Alert banner to Admin -->
        <mxCell id="msg_11" value="11: عرض شارة تنبيهية: &quot;يوجد متجر جديد بانتظار التوثيق!&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#EF4444;fontColor=#991B1B;" edge="1" parent="1" source="ll_mvc" target="ll_admin">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="535" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 12: Admin clicks approve -->
        <mxCell id="msg_12" value="12: النقر على زر &quot;توثيق&quot; (Approve Store)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#EF4444;fontColor=#991B1B;strokeWidth=2;" edge="1" parent="1" source="ll_admin" target="ll_mvc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="575" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 13: Portal updates DB -->
        <mxCell id="msg_13" value="13: UPDATE Stores SET IsApproved=true WHERE Id=@id" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#2563EB;fontColor=#1E40AF;strokeWidth=2;" edge="1" parent="1" source="ll_mvc" target="ll_db">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="610" />
            </Array>
          </mxGeometry>
