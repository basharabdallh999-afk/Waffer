  <diagram id="ArchitectureDiagram" name="Architecture Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#F8FAFC" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Main Title -->
        <mxCell id="title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;منظومة منصة وَفِّر - مخطط المعمارية الشامل (System Architecture Diagram)&lt;/b&gt;&lt;br&gt;Clean Architecture &amp;amp; Multi-Tier Cross-Platform Ecosystem" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#1E293B;fontColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="770" height="60" as="geometry" />
        </mxCell>

        <!-- Container: Client Layer -->
        <mxCell id="box_client" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;1. طبقة واجهات العميل (Client / Presentation Tier)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#166534;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="480" height="340" as="geometry" />
        </mxCell>
        
        <!-- Flutter Mobile App -->
        <mxCell id="flutter_app" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;تطبيق الموبايل (Flutter Hybrid App)&lt;/b&gt;&lt;br&gt;(Android / iOS / Web)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;" vertex="1" parent="box_client">
          <mxGeometry x="30" y="45" width="420" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="flutter_presentation" value="&lt;b&gt;Presentation Layer (UI &amp;amp; State)&lt;/b&gt;&lt;br&gt;Screens: Home, Favorites, Merchant Dashboard, Auth&lt;br&gt;Widgets: Animated Banner (3s), Filter SheetModal, Drawer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;fontColor=#0369A1;align=center;" vertex="1" parent="box_client">
          <mxGeometry x="30" y="110" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="flutter_domain" value="&lt;b&gt;Domain Layer (Business Rules &amp;amp; Use Cases)&lt;/b&gt;&lt;br&gt;Use Cases: Login, RegisterMerchant, GetOffers, FilterOffers&lt;br&gt;Entities: User, Offer, Merchant, Category" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;align=center;" vertex="1" parent="box_client">
          <mxGeometry x="30" y="185" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="flutter_data" value="&lt;b&gt;Data Layer (Repositories &amp;amp; Remote Source)&lt;/b&gt;&lt;br&gt;OffersRemoteDataSource (HTTP Client) | LocalStorage (Tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;align=center;" vertex="1" parent="box_client">
          <mxGeometry x="30" y="260" width="420" height="55" as="geometry" />
        </mxCell>

        <!-- Container: Admin Portal MVC -->
        <mxCell id="box_admin" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;2. بوابة الإدارة والتحكم (Admin Web Portal - MVC)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="630" y="110" width="480" height="340" as="geometry" />
        </mxCell>
        
        <mxCell id="mvc_app" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;موقع الإدارة والمشرف (ASP.NET Core MVC)&lt;/b&gt;&lt;br&gt;Bootstrap 5 | Icons | DataTables.js | Custom Fonts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;" vertex="1" parent="box_admin">
          <mxGeometry x="30" y="45" width="420" height="50" as="geometry" />
        </mxCell>

        <mxCell id="mvc_controllers" value="&lt;b&gt;MVC Controllers &amp;amp; ViewModels&lt;/b&gt;&lt;br&gt;DashboardController | MerchantsController | OffersController | AuthController" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#1E40AF;align=center;" vertex="1" parent="box_admin">
          <mxGeometry x="30" y="110" width="420" height="55" as="geometry" />
        </mxCell>

        <mxCell id="mvc_views" value="&lt;b&gt;Razor Views (Interactive UI)&lt;/b&gt;&lt;br&gt;5 Views per Table (Index, Details, Create, Edit, Delete)&lt;br&gt;Bootstrap Modals (إيقاف المتجر، التوثيق، الحذف)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;align=center;" vertex="1" parent="box_admin">
          <mxGeometry x="30" y="180" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mvc_logic" value="&lt;b&gt;Business Governance Logic&lt;/b&gt;&lt;br&gt;مراجعة وتوثيق المتاجر | الإيقاف المؤقت/النهائي | إدارة الإعلانات المميزة" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;align=center;" vertex="1" parent="box_admin">
          <mxGeometry x="30" y="255" width="420" height="60" as="geometry" />
        </mxCell>

        <!-- Container: Backend API Layer -->
        <mxCell id="box_api" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;3. طبقة الخدمات والواجهة البرمجية (Backend RESTful Web API - ASP.NET Core 10)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;fillColor=#FAF5FF;strokeColor=#7C3AED;fontColor=#5B21B6;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="1050" height="150" as="geometry" />
        </mxCell>
        
        <mxCell id="api_endpoints" value="&lt;b&gt;API Endpoints (Controllers)&lt;/b&gt;&lt;br&gt;/api/auth (Login, Register)&lt;br&gt;/api/offers (All, Sponsored)&lt;br&gt;/api/merchants | /api/categories" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#A78BFA;fontColor=#5B21B6;align=center;" vertex="1" parent="box_api">
          <mxGeometry x="40" y="45" width="280" height="85" as="geometry" />
        </mxCell>

        <mxCell id="api_middleware" value="&lt;b&gt;Cross-Cutting Middleware&lt;/b&gt;&lt;br&gt;Global Exception Handler&lt;br&gt;JWT / Role-Based Authorization&lt;br&gt;Model Validation (DataAnnotations)&lt;br&gt;Swagger / OpenAPI UI (Testing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#A78BFA;fontColor=#5B21B6;align=center;" vertex="1" parent="box_api">
          <mxGeometry x="380" y="45" width="290" height="85" as="geometry" />
