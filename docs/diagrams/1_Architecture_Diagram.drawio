<mxfile host="app.diagrams.net" modified="2026-09-11T13:30:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="Standard_Architecture" name="Multi-Tier Architecture Diagram">
    <mxGraphModel dx="1250" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1050" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="arch_title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;مخطط المعمارية الهندسية الشاملة لمنصة وَفِّر (System Architecture Diagram)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #475569;&quot;&gt;Clean Architecture &amp;amp; Multi-Tier Enterprise Ecosystem (.NET 10 Web API + MVC + Flutter Mobile)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#F8FAFC;fontColor=#0F172A;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="175" y="20" width="850" height="50" as="geometry" />
        </mxCell>

        <!-- TIER 1: CLIENT TIER -->
        <mxCell id="box_tier1" value="الطبقة الأولى: واجهات العميل (Client Devices &amp;amp; Presentation Tier)" style="swimlane;whiteSpace=wrap;html=1;rounded=0;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#166534;startSize=26;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="1040" height="160" as="geometry" />
        </mxCell>

        <mxCell id="c_flutter" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;📱 تطبيق الموبايل (Flutter Mobile App)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #334155;&quot;&gt;• &lt;b&gt;واجهة المستهلك:&lt;/b&gt; تصفح العروض، البحث، الفلترة (SheetModal)، المفضلة&lt;br&gt;• &lt;b&gt;واجهة التاجر:&lt;/b&gt; تسجيل المتجر، لوحة تحكم المتجر، نشر وتعديل العروض&lt;br&gt;• شريط البنرات المتحرك كل 3 ثوانٍ | خط Cairo المحلي | مؤشرات Shimmer&lt;br&gt;• &lt;b&gt;بروتوكول الاتصال:&lt;/b&gt; HTTP Client / JSON Serialization&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E40AF;align=left;spacingLeft=15;" vertex="1" parent="box_tier1">
          <mxGeometry x="30" y="40" width="470" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c_browser" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;💻 متصفح الويب - بوابة الإدارة (Admin Web Portal)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #334155;&quot;&gt;• لوحة تحكم المشرف والمدير المركزي (Responsive Web)&lt;br&gt;• مراجعة وتوثيق المتاجر الجديدة بضغطة زر (Approve)&lt;br&gt;• نظام الإيقاف المؤقت (لأيام) والنهائي عبر Modal Dialogs&lt;br&gt;• ترقية العروض كـ إعلانات مميزة وتحديد أولوية الظهور في البنر&lt;br&gt;• &lt;b&gt;التقنيات:&lt;/b&gt; HTML5, CSS Variables, Bootstrap 5.3, DataTables.js&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#5B21B6;align=left;spacingLeft=15;" vertex="1" parent="box_tier1">
          <mxGeometry x="540" y="40" width="470" height="100" as="geometry" />
        </mxCell>

        <!-- TIER 2: SERVER & APPLICATION TIER -->
        <mxCell id="box_tier2" value="الطبقة الثانية: طبقة الخوادم والتطبيقات (Application &amp;amp; Gateway Tier - ASP.NET Core 10)" style="swimlane;whiteSpace=wrap;html=1;rounded=0;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;startSize=26;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="1040" height="180" as="geometry" />
        </mxCell>

        <mxCell id="c_api" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🔌 RESTful Web API (SanaaOffersApi.API)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #334155;&quot;&gt;• &lt;b&gt;AuthController:&lt;/b&gt; تسجيل المستهلك، تسجيل التاجر، تسجيل الدخول&lt;br&gt;• &lt;b&gt;OffersController:&lt;/b&gt; جلب العروض النشطة، الإعلانات المميزة (/sponsored)&lt;br&gt;• &lt;b&gt;MerchantsController:&lt;/b&gt; فحص حالة الاعتماد والإيقاف للتاجر&lt;br&gt;• &lt;b&gt;Middlewares:&lt;/b&gt; Global Exception Handler | DataAnnotations Validation&lt;br&gt;• &lt;b&gt;Interactive Documentation:&lt;/b&gt; Swagger / OpenAPI 3.0 UI&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#065F46;align=left;spacingLeft=15;" vertex="1" parent="box_tier2">
          <mxGeometry x="30" y="40" width="470" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c_mvc" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;🌐 MVC Web Engine (SanaaOffers.MVC)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #334155;&quot;&gt;• &lt;b&gt;Controllers:&lt;/b&gt; DashboardController, MerchantsController, OffersController&lt;br&gt;• &lt;b&gt;5 Views لكل جدول:&lt;/b&gt; Index, Details, Create, Edit, Delete&lt;br&gt;• &lt;b&gt;DataTables.js:&lt;/b&gt; جداول تفاعلية للبحث، الفرز، والترقيم التلقائي&lt;br&gt;• &lt;b&gt;Modals:&lt;/b&gt; نافذة إيقاف المتجر، نافذة تأكيد الحذف، نافذة التوثيق&lt;br&gt;• &lt;b&gt;Security:&lt;/b&gt; Cookie Authentication + Role-Based Access Control&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontColor=#92400E;align=left;spacingLeft=15;" vertex="1" parent="box_tier2">
          <mxGeometry x="540" y="40" width="470" height="120" as="geometry" />
        </mxCell>

        <!-- TIER 3: BUSINESS & REPOSITORY LAYER -->
        <mxCell id="box_tier3" value="الطبقة الثالثة: منطق الأعمال ومستودع البيانات (Core Domain &amp;amp; Repository Pattern Tier)" style="swimlane;whiteSpace=wrap;html=1;rounded=0;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;startSize=26;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="1040" height="160" as="geometry" />
        </mxCell>

        <mxCell id="c_services" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;قواعد العمل والخدمات (Business Services &amp;amp; Logic)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #334155;&quot;&gt;• &lt;b&gt;Merchant Lifecycle Engine:&lt;/b&gt; منع نشر العروض تلقائياً إذا كان المتجر غير معتمد أو موقوفاً&lt;br&gt;• &lt;b&gt;Suspension Rule:&lt;/b&gt; التحقق من انتهاء مهلة الإيقاف المؤقت (SuspendedUntil) وإعادة التفعيل&lt;br&gt;• &lt;b&gt;Sponsored Banners Logic:&lt;/b&gt; ترتيب العروض المميزة حسب الأولوية والتاريخ&lt;br&gt;• &lt;b&gt;Security Services:&lt;/b&gt; تشفير كلمات المرور خوارزمياً (PasswordHasher)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontColor=#78350F;align=left;spacingLeft=15;" vertex="1" parent="box_tier3">
          <mxGeometry x="30" y="40" width="470" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c_repo" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;نمط مستودع البيانات (Repository Pattern &amp;amp; Unit of Work)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #334155;&quot;&gt;• &lt;b&gt;Interfaces:&lt;/b&gt; IRepository&amp;lt;T&amp;gt;, IOffersRepository, IMerchantsRepository&lt;br&gt;• &lt;b&gt;Implementations:&lt;/b&gt; GenericRepository&amp;lt;T&amp;gt; مع دعم استعلامات LINQ غير المتزامنة (async)&lt;br&gt;• &lt;b&gt;Decoupling:&lt;/b&gt; فصل كامل بين قواعد البيانات ومنطق الأعمال لتسهيل الصيانة والاختبار&lt;br&gt;• &lt;b&gt;Dependency Injection:&lt;/b&gt; تسجيل المستودعات بنطاق Scoped داخل حاوية IoC&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E40AF;align=left;spacingLeft=15;" vertex="1" parent="box_tier3">
          <mxGeometry x="540" y="40" width="470" height="100" as="geometry" />
        </mxCell>

        <!-- TIER 4: DATA PERSISTENCE & STORAGE -->
        <mxCell id="box_tier4" value="الطبقة الرابعة: استدامة وتخزين البيانات (Data Persistence &amp;amp; Storage Tier - Entity Framework Core)" style="swimlane;whiteSpace=wrap;html=1;rounded=0;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;startSize=26;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="680" width="1040" height="160" as="geometry" />
        </mxCell>

        <mxCell id="c_ef" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Entity Framework Core 10 (ORM)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #334155;&quot;&gt;• ApplicationDbContext&lt;br&gt;• LINQ Query Engine&lt;br&gt;• Code-First Migrations&lt;br&gt;• ACID Transactions (نقاء العمليات)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EF4444;fontColor=#991B1B;align=center;" vertex="1" parent="box_tier4">
          <mxGeometry x="30" y="40" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c_database" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Relational Database (SQLite / SQL Server)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #334155;&quot;&gt;• &lt;b&gt;Users Table:&lt;/b&gt; الحسابات المشفرة والصلاحيات (Admin, Merchant, Consumer)&lt;br&gt;• &lt;b&gt;Merchants Table:&lt;/b&gt; بيانات المتاجر، الشعار، حالة التوثيق (IsApproved)، الإيقاف&lt;br&gt;• &lt;b&gt;Offers Table:&lt;/b&gt; العروض، الأسعار، الصور، الإعلانات المميزة (FK -&gt; Merchants)&lt;br&gt;• &lt;b&gt;Categories Table:&lt;/b&gt; الأقسام والتصنيفات التجارية (FK -&gt; Offers)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#D97706;fontColor=#92400E;align=left;spacingLeft=15;" vertex="1" parent="box_tier4">
          <mxGeometry x="280" y="35" width="480" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c_storage" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Media Storage (الوسائط)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #334155;&quot;&gt;• صور العروض والتخفيضات&lt;br&gt;• مسار: /wwwroot/images/&lt;br&gt;• خدمة حفظ ومعالجة الصور&lt;br&gt;• استضافة الملفات الثابتة&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;align=center;" vertex="1" parent="box_tier4">
          <mxGeometry x="790" y="40" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- CONNECTION ARROWS (CLEAR ORTHOGONAL LINES) -->
        <!-- Flutter to Web API -->
        <mxCell id="arr_flutter_api" value="&lt;b&gt;HTTPS / REST JSON (Port 5232)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#2563EB;fontColor=#1E40AF;" edge="1" parent="1" source="c_flutter" target="c_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Browser to MVC -->
        <mxCell id="arr_browser_mvc" value="&lt;b&gt;HTTPS / Razor HTTP (Port 5069)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#7C3AED;fontColor=#5B21B6;" edge="1" parent="1" source="c_browser" target="c_mvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Tier 2 to Tier 3 -->
        <mxCell id="arr_tier2_tier3" value="&lt;b&gt;Service Layer Invocation / Dependency Injection (IoC)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#10B981;fontColor=#065F46;" edge="1" parent="1" source="box_tier2" target="box_tier3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Tier 3 to Tier 4 -->
        <mxCell id="arr_tier3_tier4" value="&lt;b&gt;EF Core DbContext ◄► Relational Schema Mapping (CRUD &amp;amp; ACID)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#DC2626;fontColor=#991B1B;" edge="1" parent="1" source="box_tier3" target="box_tier4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
