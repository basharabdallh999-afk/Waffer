        <mxCell id="api_repository" value="&lt;b&gt;Repository Pattern &amp;amp; Core Services&lt;/b&gt;&lt;br&gt;IOffersRepository | IMerchantRepository&lt;br&gt;Unit of Work | Dependency Injection&lt;br&gt;Entity Framework Core 10 DbContext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#A78BFA;fontColor=#5B21B6;align=center;" vertex="1" parent="box_api">
          <mxGeometry x="730" y="45" width="280" height="85" as="geometry" />
        </mxCell>

        <!-- Container: Data Tier -->
