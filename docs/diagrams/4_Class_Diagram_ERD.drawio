<mxfile host="app.diagrams.net" modified="2026-09-11T13:50:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="Class_ERD_Fixed" name="UML Class &amp; ERD Diagram">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="980" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="cls_title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;مخطط الأصناف وقاعدة البيانات القياسي لمنصة وَفِّر (UML Class Diagram &amp;amp; ERD)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #475569;&quot;&gt;Domain Entities, Attributes, Data Types, Multiplicities &amp;amp; Business Methods&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#F8FAFC;fontColor=#0F172A;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="800" height="50" as="geometry" />
        </mxCell>

        <!-- 1. USER CLASS (Top Left) -->
        <mxCell id="class_user" value="&lt;div style=&quot;background-color: #2563EB; color: #ffffff; font-weight: bold; font-size: 14px; padding: 7px; text-align: center; border-radius: 4px 4px 0 0;&quot;&gt;User (المستخدم)&lt;/div&gt;&lt;div style=&quot;padding: 10px; text-align: left; font-size: 11px; line-height: 1.6; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #2563EB;&quot;&gt;+ Id:&lt;/b&gt; int [PK]&lt;br&gt;&lt;b style=&quot;color: #2563EB;&quot;&gt;+ FullName:&lt;/b&gt; string [Required]&lt;br&gt;&lt;b style=&quot;color: #2563EB;&quot;&gt;+ Email:&lt;/b&gt; string [Unique]&lt;br&gt;&lt;b style=&quot;color: #2563EB;&quot;&gt;+ PasswordHash:&lt;/b&gt; string [Required]&lt;br&gt;&lt;b style=&quot;color: #2563EB;&quot;&gt;+ Phone:&lt;/b&gt; string?&lt;br&gt;&lt;b style=&quot;color: #2563EB;&quot;&gt;+ Role:&lt;/b&gt; UserRole (Consumer / Merchant / Admin)&lt;br&gt;&lt;b style=&quot;color: #2563EB;&quot;&gt;+ IsActive:&lt;/b&gt; bool = true&lt;br&gt;&lt;b style=&quot;color: #2563EB;&quot;&gt;+ CreatedAt:&lt;/b&gt; DateTime&lt;/div&gt;&lt;hr style=&quot;margin: 0; border: 0; border-top: 1px solid #BFDBFE;&quot;&gt;&lt;div style=&quot;padding: 8px 10px; text-align: left; font-size: 11px; line-height: 1.6; color: #1D4ED8;&quot;&gt;+ Register(fullName, email, password): bool&lt;br&gt;+ Authenticate(password): bool&lt;br&gt;+ UpdateProfile(fullName, phone): void&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;verticalAlign=top;align=center;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="320" height="280" as="geometry" />
        </mxCell>

        <!-- 2. MERCHANT CLASS (Top Center) -->
        <mxCell id="class_merchant" value="&lt;div style=&quot;background-color: #059669; color: #ffffff; font-weight: bold; font-size: 14px; padding: 7px; text-align: center; border-radius: 4px 4px 0 0;&quot;&gt;Merchant / Store (المتجر)&lt;/div&gt;&lt;div style=&quot;padding: 10px; text-align: left; font-size: 11px; line-height: 1.6; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #059669;&quot;&gt;+ Id:&lt;/b&gt; int [PK]&lt;br&gt;&lt;b style=&quot;color: #059669;&quot;&gt;+ StoreName:&lt;/b&gt; string [Required]&lt;br&gt;&lt;b style=&quot;color: #059669;&quot;&gt;+ Phone:&lt;/b&gt; string?&lt;br&gt;&lt;b style=&quot;color: #059669;&quot;&gt;+ Address:&lt;/b&gt; string?&lt;br&gt;&lt;b style=&quot;color: #059669;&quot;&gt;+ Latitude:&lt;/b&gt; double?&lt;br&gt;&lt;b style=&quot;color: #059669;&quot;&gt;+ Longitude:&lt;/b&gt; double?&lt;br&gt;&lt;b style=&quot;color: #059669;&quot;&gt;+ IsApproved:&lt;/b&gt; bool = false&lt;br&gt;&lt;b style=&quot;color: #059669;&quot;&gt;+ IsSuspended:&lt;/b&gt; bool = false&lt;br&gt;&lt;b style=&quot;color: #059669;&quot;&gt;+ SuspensionReason:&lt;/b&gt; string?&lt;br&gt;&lt;b style=&quot;color: #059669;&quot;&gt;+ SuspendedUntil:&lt;/b&gt; DateTime?&lt;br&gt;&lt;b style=&quot;color: #059669;&quot;&gt;+ CreatedAt:&lt;/b&gt; DateTime&lt;br&gt;&lt;b style=&quot;color: #059669;&quot;&gt;+ UserId:&lt;/b&gt; int [FK -&amp;gt; User.Id]&lt;/div&gt;&lt;hr style=&quot;margin: 0; border: 0; border-top: 1px solid #A7F3D0;&quot;&gt;&lt;div style=&quot;padding: 8px 10px; text-align: left; font-size: 11px; line-height: 1.6; color: #047857;&quot;&gt;+ Approve(): void&lt;br&gt;+ Suspend(days: int, reason: string): void&lt;br&gt;+ Reactivate(): void&lt;br&gt;+ CanPublishOffers(): bool&lt;br&gt;+ IsCurrentlySuspended(): bool&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;verticalAlign=top;align=center;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="470" y="110" width="340" height="350" as="geometry" />
        </mxCell>

        <!-- 3. CATEGORY CLASS (Top Right) -->
        <mxCell id="class_category" value="&lt;div style=&quot;background-color: #D97706; color: #ffffff; font-weight: bold; font-size: 14px; padding: 7px; text-align: center; border-radius: 4px 4px 0 0;&quot;&gt;Category (القسم التجاري)&lt;/div&gt;&lt;div style=&quot;padding: 10px; text-align: left; font-size: 11px; line-height: 1.6; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #D97706;&quot;&gt;+ Id:&lt;/b&gt; int [PK]&lt;br&gt;&lt;b style=&quot;color: #D97706;&quot;&gt;+ Name:&lt;/b&gt; string [Required]&lt;br&gt;&lt;b style=&quot;color: #D97706;&quot;&gt;+ Description:&lt;/b&gt; string?&lt;br&gt;&lt;b style=&quot;color: #D97706;&quot;&gt;+ Icon:&lt;/b&gt; string? = &quot;bi-tag&quot;&lt;/div&gt;&lt;hr style=&quot;margin: 0; border: 0; border-top: 1px solid #FDE68A;&quot;&gt;&lt;div style=&quot;padding: 8px 10px; text-align: left; font-size: 11px; line-height: 1.6; color: #B45309;&quot;&gt;+ GetActiveOffers(): List&amp;lt;Offer&amp;gt;&lt;br&gt;+ GetOffersCount(): int&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=center;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="890" y="110" width="320" height="200" as="geometry" />
        </mxCell>

        <!-- 4. OFFER CLASS (Bottom Center) -->
        <mxCell id="class_offer" value="&lt;div style=&quot;background-color: #DC2626; color: #ffffff; font-weight: bold; font-size: 14px; padding: 7px; text-align: center; border-radius: 4px 4px 0 0;&quot;&gt;Offer (العرض التجاري)&lt;/div&gt;&lt;div style=&quot;padding: 10px; text-align: left; font-size: 11px; line-height: 1.6; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ Id:&lt;/b&gt; int [PK]&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ Title:&lt;/b&gt; string [Required]&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ Description:&lt;/b&gt; string?&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ OriginalPrice:&lt;/b&gt; decimal&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ DiscountedPrice:&lt;/b&gt; decimal&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ ImageUrl:&lt;/b&gt; string? [مسار الصورة]&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ StartDate:&lt;/b&gt; DateTime&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ EndDate:&lt;/b&gt; DateTime&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ IsFlashSale:&lt;/b&gt; bool = false&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ IsSponsored:&lt;/b&gt; bool = false [إعلان مميز]&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ DisplayPriority:&lt;/b&gt; int = 0 [أولوية البنر]&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ IsActive:&lt;/b&gt; bool = true&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ ViewsCount:&lt;/b&gt; int = 0&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ CreatedAt:&lt;/b&gt; DateTime&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ MerchantId:&lt;/b&gt; int [FK -&amp;gt; Merchant.Id]&lt;br&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;+ CategoryId:&lt;/b&gt; int [FK -&amp;gt; Category.Id]&lt;/div&gt;&lt;hr style=&quot;margin: 0; border: 0; border-top: 1px solid #FECACA;&quot;&gt;&lt;div style=&quot;padding: 8px 10px; text-align: left; font-size: 11px; line-height: 1.6; color: #991B1B;&quot;&gt;+ CalculateDiscountPercentage(): double&lt;br&gt;+ IsExpired(): bool&lt;br&gt;+ SetSponsoredBanner(priority: int): void&lt;br&gt;+ IncrementViews(): void&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=center;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="470" y="530" width="340" height="420" as="geometry" />
        </mxCell>

        <!-- ================= RELATIONSHIP CONNECTORS ================= -->
        <!-- 1. User (1) to Merchant (0..*) -->
        <mxCell id="rel_u_m" value="&lt;b&gt;1&lt;/b&gt; owns &lt;b&gt;0..*&lt;/b&gt;&#xa;[UserId]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.3;entryDx=0;entryDy=0;exitX=1;exitY=0.4;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#2563EB;fontColor=#1E40AF;align=center;" edge="1" parent="1" source="class_user" target="class_merchant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. Merchant (1) to Offer (0..*) -->
        <mxCell id="rel_m_o" value="&lt;b&gt;1&lt;/b&gt; publishes &lt;b&gt;0..*&lt;/b&gt;&#xa;[MerchantId]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2.5;strokeColor=#059669;fontColor=#065F46;align=center;" edge="1" parent="1" source="class_merchant" target="class_offer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. Category (1) to Offer (0..*) -->
        <mxCell id="rel_c_o" value="&lt;b&gt;1&lt;/b&gt; categorizes &lt;b&gt;0..*&lt;/b&gt;&#xa;[CategoryId]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.3;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#D97706;fontColor=#92400E;align=center;" edge="1" parent="1" source="class_category" target="class_offer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1050" y="656" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
