<mxfile host="app.diagrams.net" modified="2026-09-11T12:00:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="ClassDiagram" name="Class Diagram &amp; ERD">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#F8FAFC" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title_cls" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;مخطط الأصناف وقواعد البيانات لمنصة وَفِّر (UML Class Diagram &amp;amp; Entity-Relationship)&lt;/b&gt;&lt;br&gt;Core Domain Entities, Attributes, Methods, and Foreign Key Relationships" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#1E293B;fontColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="810" height="50" as="geometry" />
        </mxCell>

        <!-- 1. User Class -->
        <mxCell id="class_user" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;User (المستخدم)&lt;/b&gt;&#xa;--------------------------------------------&#xa;+ Id: int [PK]&#xa;+ FullName: string&#xa;+ Email: string [Unique]&#xa;+ PasswordHash: string&#xa;+ PhoneNumber: string&#xa;+ Role: string (&quot;Admin&quot;,&quot;Merchant&quot;,&quot;User&quot;)&#xa;+ CreatedAt: DateTime&#xa;--------------------------------------------&#xa;+ Register(): AuthResult&#xa;+ Login(email, pass): Token&#xa;+ UpdateProfile(): bool" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E40AF;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="240" height="230" as="geometry" />
        </mxCell>

        <!-- 2. Store Class -->
        <mxCell id="class_store" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Store / Merchant (المتجر)&lt;/b&gt;&#xa;--------------------------------------------&#xa;+ Id: int [PK]&#xa;+ Name: string&#xa;+ Description: string&#xa;+ LogoUrl: string&#xa;+ IsApproved: bool = false&#xa;+ IsSuspended: bool = false&#xa;+ SuspendedUntil: DateTime?&#xa;+ SuspensionReason: string?&#xa;+ OwnerId: int [FK -&gt; User.Id]&#xa;+ CreatedAt: DateTime&#xa;--------------------------------------------&#xa;+ Approve(): void&#xa;+ Suspend(days: int, reason: string): void&#xa;+ Activate(): void&#xa;+ CanPublishOffers(): bool" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;align=left;" vertex="1" parent="1">
          <mxGeometry x="440" y="100" width="280" height="260" as="geometry" />
        </mxCell>

        <!-- 3. Category Class -->
        <mxCell id="class_category" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Category (القسم)&lt;/b&gt;&#xa;--------------------------------------------&#xa;+ Id: int [PK]&#xa;+ Name: string&#xa;+ IconName: string&#xa;+ Description: string&#xa;--------------------------------------------&#xa;+ GetOffers(): List&lt;Offer&gt;&#xa;+ GetActiveCount(): int" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;align=left;" vertex="1" parent="1">
          <mxGeometry x="870" y="100" width="230" height="170" as="geometry" />
        </mxCell>

        <!-- 4. Offer Class -->
        <mxCell id="class_offer" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Offer (العرض التجاري)&lt;/b&gt;&#xa;--------------------------------------------&#xa;+ Id: int [PK]&#xa;+ Title: string&#xa;+ Description: string&#xa;+ OriginalPrice: decimal&#xa;+ DiscountedPrice: decimal&#xa;+ DiscountPercentage: double&#xa;+ ImageUrl: string&#xa;+ StartDate: DateTime&#xa;+ EndDate: DateTime&#xa;+ IsSponsored: bool = false&#xa;+ DisplayPriority: int = 0&#xa;+ StoreId: int [FK -&gt; Store.Id]&#xa;+ CategoryId: int [FK -&gt; Category.Id]&#xa;--------------------------------------------&#xa;+ CalculateSaving(): decimal&#xa;+ IsActive(): bool&#xa;+ SetSponsoredBanner(priority: int): void" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;align=left;" vertex="1" parent="1">
          <mxGeometry x="440" y="440" width="280" height="280" as="geometry" />
        </mxCell>

        <!-- 5. Branch Class -->
        <mxCell id="class_branch" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Branch (فرع المتجر)&lt;/b&gt;&#xa;--------------------------------------------&#xa;+ Id: int [PK]&#xa;+ StoreId: int [FK -&gt; Store.Id]&#xa;+ City: string&#xa;+ Address: string&#xa;+ Phone: string&#xa;--------------------------------------------&#xa;+ GetLocation(): string" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;align=left;" vertex="1" parent="1">
          <mxGeometry x="870" y="440" width="230" height="160" as="geometry" />
        </mxCell>

        <!-- 6. Favorite Class -->
        <mxCell id="class_fav" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Favorite (المفضلة)&lt;/b&gt;&#xa;--------------------------------------------&#xa;+ Id: int [PK]&#xa;+ UserId: int [FK -&gt; User.Id]&#xa;+ OfferId: int [FK -&gt; Offer.Id]&#xa;+ AddedAt: DateTime&#xa;--------------------------------------------&#xa;+ ToggleFavorite(): bool" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#C084FC;fontColor=#6B21A8;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- Relationships with Multiplicities -->
        <!-- User (1) to Store (1) -->
        <mxCell id="rel_user_store" value="1 owns 0..1" style="endArrow=none;html=1;entryX=0;entryY=0.3;entryDx=0;entryDy=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#2563EB;" edge="1" parent="1" source="class_user" target="class_store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Store (1) to Offer (*) -->
        <mxCell id="rel_store_offer" value="1 has many 0..*" style="endArrow=none;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=3;strokeColor=#10B981;" edge="1" parent="1" source="class_store" target="class_offer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Category (1) to Offer (*) -->
        <mxCell id="rel_cat_offer" value="1 categorizes 0..*" style="endArrow=none;html=1;entryX=1;entryY=0.3;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#F59E0B;" edge="1" parent="1" source="class_category" target="class_offer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="985" y="524" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Store (1) to Branch (*) -->
        <mxCell id="rel_store_branch" value="1 operates 1..*" style="endArrow=none;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.7;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="class_store" target="class_branch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="790" y="282" />
              <mxPoint x="790" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- User (1) to Favorite (*) -->
        <mxCell id="rel_user_fav" value="1 adds 0..*" style="endArrow=none;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#C084FC;" edge="1" parent="1" source="class_user" target="class_fav">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Offer (1) to Favorite (*) -->
        <mxCell id="rel_offer_fav" value="1 saved in 0..*" style="endArrow=none;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#EF4444;" edge="1" parent="1" source="class_offer" target="class_fav">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
