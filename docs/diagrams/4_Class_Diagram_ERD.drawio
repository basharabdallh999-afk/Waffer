<mxfile host="app.diagrams.net" modified="2026-09-11T13:30:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="Standard_Class_ERD" name="UML Class &amp; ERD Diagram">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="950" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="cls_title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;مخطط الأصناف وقاعدة البيانات القياسي لمنصة وَفِّر (UML Class Diagram &amp;amp; ERD)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #475569;&quot;&gt;Domain Entities, Attributes, Data Types, Multiplicities &amp;amp; Business Methods&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#F8FAFC;fontColor=#0F172A;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="800" height="50" as="geometry" />
        </mxCell>

        <!-- 1. CLASS: USER (Top Left) -->
        <mxCell id="c_user" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;User (المستخدم)&lt;/b&gt;&#xa;---------------------------------------------------------&#xa;+ Id: int [PK]&#xa;+ FullName: string&#xa;+ Email: string [Unique]&#xa;+ PasswordHash: string&#xa;+ Phone: string?&#xa;+ Role: UserRole (Consumer / Merchant / Admin)&#xa;+ IsActive: bool = true&#xa;+ CreatedAt: DateTime&#xa;---------------------------------------------------------&#xa;+ Register(fullName, email, password): bool&#xa;+ Authenticate(password): bool&#xa;+ UpdateProfile(fullName, phone): void" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="320" height="240" as="geometry" />
        </mxCell>

        <!-- 2. CLASS: CATEGORY (Top Right) -->
        <mxCell id="c_category" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Category (القسم التجاري)&lt;/b&gt;&#xa;---------------------------------------------------------&#xa;+ Id: int [PK]&#xa;+ Name: string [Required]&#xa;+ Description: string?&#xa;+ Icon: string? = &quot;bi-tag&quot;&#xa;---------------------------------------------------------&#xa;+ GetActiveOffers(): List&lt;Offer&gt;&#xa;+ GetOffersCount(): int" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="310" height="170" as="geometry" />
        </mxCell>

        <!-- 3. CLASS: MERCHANT (Center) -->
        <mxCell id="c_merchant" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Merchant / Store (المتجر)&lt;/b&gt;&#xa;---------------------------------------------------------&#xa;+ Id: int [PK]&#xa;+ StoreName: string [Required]&#xa;+ Phone: string?&#xa;+ Address: string?&#xa;+ Latitude: double?&#xa;+ Longitude: double?&#xa;+ IsApproved: bool = false&#xa;+ IsSuspended: bool = false&#xa;+ SuspensionReason: string?&#xa;+ SuspendedUntil: DateTime?&#xa;+ CreatedAt: DateTime&#xa;+ UserId: int [FK -&gt; User.Id]&#xa;---------------------------------------------------------&#xa;+ Approve(): void&#xa;+ Suspend(days: int, reason: string): void&#xa;+ Reactivate(): void&#xa;+ CanPublishOffers(): bool&#xa;+ IsCurrentlySuspended(): bool" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="210" width="340" height="320" as="geometry" />
        </mxCell>

        <!-- 4. CLASS: OFFER (Bottom Center) -->
        <mxCell id="c_offer" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Offer (العرض التجاري)&lt;/b&gt;&#xa;---------------------------------------------------------&#xa;+ Id: int [PK]&#xa;+ Title: string [Required]&#xa;+ Description: string?&#xa;+ OriginalPrice: decimal&#xa;+ DiscountedPrice: decimal&#xa;+ ImageUrl: string? [مسار صورة العرض]&#xa;+ StartDate: DateTime&#xa;+ EndDate: DateTime&#xa;+ IsFlashSale: bool = false&#xa;+ IsSponsored: bool = false [إعلان مميز]&#xa;+ DisplayPriority: int = 0 [أولوية البنر]&#xa;+ IsActive: bool = true&#xa;+ ViewsCount: int = 0&#xa;+ CreatedAt: DateTime&#xa;+ MerchantId: int [FK -&gt; Merchant.Id]&#xa;+ CategoryId: int [FK -&gt; Category.Id]&#xa;---------------------------------------------------------&#xa;+ CalculateDiscountPercentage(): double&#xa;+ IsExpired(): bool&#xa;+ SetSponsoredBanner(priority: int): void&#xa;+ IncrementViews(): void" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="580" width="340" height="360" as="geometry" />
        </mxCell>

        <!-- RELATIONSHIPS WITH MULTIPLICITIES & ROLES -->
        <!-- User (1) to Merchant (0..*) -->
        <mxCell id="rel_u_m" value="&lt;b&gt;1&lt;/b&gt; owns &lt;b&gt;0..*&lt;/b&gt;&#xa;[UserId]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.3;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#2563EB;fontColor=#1E40AF;align=center;" edge="1" parent="1" source="c_user" target="c_merchant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Merchant (1) to Offer (0..*) -->
        <mxCell id="rel_m_o" value="&lt;b&gt;1&lt;/b&gt; publishes &lt;b&gt;0..*&lt;/b&gt;&#xa;[MerchantId]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2.5;strokeColor=#059669;fontColor=#065F46;align=center;" edge="1" parent="1" source="c_merchant" target="c_offer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Category (1) to Offer (0..*) -->
        <mxCell id="rel_c_o" value="&lt;b&gt;1&lt;/b&gt; categorizes &lt;b&gt;0..*&lt;/b&gt;&#xa;[CategoryId]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.3;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#D97706;fontColor=#92400E;align=center;" edge="1" parent="1" source="c_category" target="c_offer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="975" y="688" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
