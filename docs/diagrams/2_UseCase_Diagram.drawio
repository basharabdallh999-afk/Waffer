        <mxCell id="uc_c8" value="فتح القائمة الجانبية (Drawer) والروابط السريعة&#xa;(Navigate via App Drawer)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1D4ED8;fontStyle=1;fontSize=11;" vertex="1" parent="group_consumer">
          <mxGeometry x="420" y="165" width="230" height="50" as="geometry" />
