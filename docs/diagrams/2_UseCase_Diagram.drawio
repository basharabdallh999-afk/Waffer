          <mxGeometry x="250" y="100" width="850" height="960" as="geometry" />
        </mxCell>

        <!-- SUB-CONTAINER 1: SHARED / AUTH -->
        <mxCell id="group_auth" value="&lt;b&gt;العمليات المشتركة والتحقق (Shared &amp;amp; Authentication)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;startSize=24;" vertex="1" parent="sys_box">
          <mxGeometry x="30" y="45" width="790" height="95" as="geometry" />
        </mxCell>
        <mxCell id="uc_login" value="تسجيل الدخول والتحقق من الصلاحيات&#xa;(Login &amp;amp; Role Authentication)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontColor=#B45309;fontStyle=1;fontSize=11;" vertex="1" parent="group_auth">
          <mxGeometry x="30" y="32" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="uc_profile" value="إدارة وتعديل الملف الشخصي&#xa;(View &amp;amp; Edit Profile)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontColor=#B45309;fontStyle=1;fontSize=11;" vertex="1" parent="group_auth">
          <mxGeometry x="290" y="32" width="210" height="48" as="geometry" />
        </mxCell>
        <mxCell id="uc_logout" value="تسجيل الخروج وإنهاء الجلسة&#xa;(Logout &amp;amp; Clear Session)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontColor=#B45309;fontStyle=1;fontSize=11;" vertex="1" parent="group_auth">
          <mxGeometry x="540" y="32" width="210" height="48" as="geometry" />
