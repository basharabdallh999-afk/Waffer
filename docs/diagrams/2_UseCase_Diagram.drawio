        <!-- Main Title -->
        <mxCell id="title_uc" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;مخطط حالات الاستخدام الشامل لمنصة وَفِّر (Use Case Diagram)&lt;/b&gt;&lt;br&gt;Actors: Consumer, Merchant, and System Admin" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#1E293B;fontColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="670" height="60" as="geometry" />
        </mxCell>

