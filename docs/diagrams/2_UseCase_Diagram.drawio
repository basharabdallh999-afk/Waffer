        </mxCell>
        <mxCell id="uc_a6" value="رفع الإيقاف وإعادة تفعيل المتجر للنشر فوراً&#xa;(Unsuspend &amp;amp; Reactivate Store)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;fontColor=#B91C1C;fontStyle=1;fontSize=11;" vertex="1" parent="group_admin">
