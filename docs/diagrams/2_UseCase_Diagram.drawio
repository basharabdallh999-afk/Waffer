        <!-- SUB-CONTAINER 2: CONSUMER USE CASES -->
        <mxCell id="group_consumer" value="&lt;b&gt;مهام وعمليات العميل / المستهلك (Consumer Features - Mobile App)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E40AF;startSize=24;" vertex="1" parent="sys_box">
          <mxGeometry x="30" y="155" width="790" height="230" as="geometry" />
        </mxCell>
        <mxCell id="uc_c1" value="تصفح العروض اليومية والتخفيضات&#xa;(Browse Daily Offers Feed)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1D4ED8;fontStyle=1;fontSize=11;" vertex="1" parent="group_consumer">
          <mxGeometry x="20" y="35" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_c2" value="مشاهدة البنرات المميزة المتحركة آلياً (3s)&#xa;(View Auto-Scrolling Banners)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1D4ED8;fontStyle=1;fontSize=11;" vertex="1" parent="group_consumer">
          <mxGeometry x="270" y="35" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_c3" value="تصفح العروض حسب الأقسام والتصنيفات&#xa;(Browse Offers by Categories)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1D4ED8;fontStyle=1;fontSize=11;" vertex="1" parent="group_consumer">
          <mxGeometry x="540" y="35" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_c4" value="البحث الفوري بالاسم والكلمات المفتاحية&#xa;(Instant Keyword Search)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1D4ED8;fontStyle=1;fontSize=11;" vertex="1" parent="group_consumer">
