        </mxCell>
        <mxCell id="uc_c5" value="الفلترة المتقدمة والترتيب (SheetModal)&#xa;(Filter by Highest Discount / Latest)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1D4ED8;fontStyle=1;fontSize=11;" vertex="1" parent="group_consumer">
