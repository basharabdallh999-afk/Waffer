        <mxCell id="uc_c5" value="معاينة تفاصيل العرض وموقعه&#xa;(View Offer Details)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=11;fontStyle=1;" vertex="1" parent="sys_rect">
