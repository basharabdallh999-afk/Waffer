  <diagram id="Standard_UseCase" name="UML Use Case Diagram">
    <mxGraphModel dx="1250" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="uc_title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;مخطط حالات الاستخدام القياسي لمنصة وَفِّر (UML Use Case Diagram)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #475569;&quot;&gt;Waffer Platform: Consumer, Merchant, and System Admin Interactions&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#F8FAFC;fontColor=#0F172A;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="800" height="50" as="geometry" />
        </mxCell>

        <!-- SYSTEM BOUNDARY -->
        <mxCell id="sys_rect" value="نظام منصة وَفِّر (Waffer Platform System Boundary)" style="swimlane;whiteSpace=wrap;html=1;rounded=0;fillColor=#FFFFFF;strokeColor=#334155;fontColor=#0F172A;startSize=28;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="780" height="960" as="geometry" />
        </mxCell>

        <!-- SHARED USE CASE: LOGIN (CENTER TOP) -->
        <mxCell id="uc_login" value="تسجيل الدخول والتحقق&#xa;(Login &amp;amp; Authentication)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=12;" vertex="1" parent="sys_rect">
          <mxGeometry x="280" y="45" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- CONSUMER USE CASES (LEFT SIDE OF BOUNDARY) -->
        <mxCell id="uc_c1" value="تصفح العروض والتخفيضات&#xa;(Browse Active Offers)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=11;fontStyle=1;" vertex="1" parent="sys_rect">
          <mxGeometry x="40" y="125" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="uc_c2" value="مشاهدة البنرات الإعلانية المتحركة (3s)&#xa;(View Auto-Scrolling Banners)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=11;fontStyle=1;" vertex="1" parent="sys_rect">
          <mxGeometry x="40" y="195" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="uc_c3" value="تصفح العروض حسب الأقسام&#xa;(Browse by Category)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=11;fontStyle=1;" vertex="1" parent="sys_rect">
          <mxGeometry x="40" y="265" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="uc_c4" value="البحث والفلترة المتقدمة (SheetModal)&#xa;(Search &amp;amp; Filter Offers)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=11;fontStyle=1;" vertex="1" parent="sys_rect">
          <mxGeometry x="40" y="335" width="220" height="50" as="geometry" />
