          <mxGeometry x="540" y="100" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_c7" value="إضافة وحذف العروض من قائمة المفضلة&#xa;(Add / Remove from Favorites)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1D4ED8;fontStyle=1;fontSize=11;" vertex="1" parent="group_consumer">
          <mxGeometry x="150" y="165" width="230" height="50" as="geometry" />
