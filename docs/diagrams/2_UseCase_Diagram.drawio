  <diagram id="Direct_UseCase_Diagram" name="UML Use Case Diagram">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="1150" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="uc_title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;مخطط حالات الاستخدام القياسي لمنصة وَفِّر (UML Use Case Diagram)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #475569;&quot;&gt;Waffer Platform: Complete Actor-to-Use-Case Association &amp;amp; Interaction Map&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#F8FAFC;fontColor=#0F172A;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="850" height="50" as="geometry" />
        </mxCell>

        <!-- SYSTEM BOUNDARY BOX (Sent to Back) -->
        <mxCell id="sys_box" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;نظام منصة وَفِّر (Waffer Platform System Boundary)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;dashed=1;dashPattern=8 8;verticalAlign=top;align=center;spacingTop=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="810" height="980" as="geometry" />
        </mxCell>

        <!-- SHARED: LOGIN (CENTER TOP) -->
        <mxCell id="uc_login" value="تسجيل الدخول والتحقق من الصلاحيات&#xa;(Login &amp;amp; Authentication)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="525" y="125" width="240" height="55" as="geometry" />
        </mxCell>

        <!-- ================= CONSUMER USE CASES (LEFT TOP) ================= -->
        <mxCell id="uc_c1" value="تصفح العروض اليومية والتخفيضات&#xa;(Browse Daily Offers)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="200" width="220" height="48" as="geometry" />
        </mxCell>

        <mxCell id="uc_c2" value="مشاهدة البنرات المميزة المتحركة (3s)&#xa;(View Auto-Scrolling Banners)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="260" width="220" height="48" as="geometry" />
        </mxCell>

        <mxCell id="uc_c3" value="تصفح العروض حسب الأقسام&#xa;(Browse by Categories)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="320" width="220" height="48" as="geometry" />
        </mxCell>

        <mxCell id="uc_c4" value="البحث والفلترة المتقدمة (SheetModal)&#xa;(Search &amp;amp; Filter Offers)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="380" width="220" height="48" as="geometry" />
        </mxCell>

        <mxCell id="uc_c5" value="معاينة تفاصيل العرض، السعر، ونسبة التوفير&#xa;(View Offer Details &amp;amp; Discount)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="440" width="220" height="48" as="geometry" />
        </mxCell>

        <mxCell id="uc_c6" value="إضافة وحذف العروض من قائمة المفضلة&#xa;(Manage Favorites List)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="500" width="220" height="48" as="geometry" />
        </mxCell>

        <!-- ================= MERCHANT USE CASES (LEFT BOTTOM) ================= -->
