        <mxCell id="uc_m8" value="معاينة سبب ومدة الإيقاف في بطاقة حمراء تنبيهية&#xa;(View Suspension Reason &amp;amp; Duration Banner)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontColor=#047857;fontStyle=1;fontSize=11;" vertex="1" parent="group_merchant">
