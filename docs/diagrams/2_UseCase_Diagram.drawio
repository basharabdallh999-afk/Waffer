        <mxCell id="uc_m2" value="استلام نافذة: &quot;طلبك قيد المراجعة والتوثيق من الإدارة&quot;&#xa;(Receive Pending Review Modal)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontColor=#047857;fontStyle=1;fontSize=11;" vertex="1" parent="group_merchant">
          <mxGeometry x="285" y="35" width="245" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_m3" value="متابعة حالة المتجر (معتمد / قيد المراجعة / موقوف)&#xa;(Check Store Approval / Suspension Status)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontColor=#047857;fontStyle=1;fontSize=11;" vertex="1" parent="group_merchant">
          <mxGeometry x="550" y="35" width="225" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_m4" value="إضافة ونشر عرض جديد (عنوان، خصم، صورة، تاريخ)&#xa;(Create &amp;amp; Publish Store Offer)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontColor=#047857;fontStyle=1;fontSize=11;" vertex="1" parent="group_merchant">
          <mxGeometry x="20" y="105" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_m5" value="تعديل وتحديث تفاصيل العروض الخاصة به&#xa;(Edit &amp;amp; Update Store Offers)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontColor=#047857;fontStyle=1;fontSize=11;" vertex="1" parent="group_merchant">
          <mxGeometry x="285" y="105" width="245" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_m6" value="حذف العروض المنتهية أو غير المتوفرة&#xa;(Delete Store Offers)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontColor=#047857;fontStyle=1;fontSize=11;" vertex="1" parent="group_merchant">
