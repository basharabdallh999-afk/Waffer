        </mxCell>
        <mxCell id="uc_a4" value="رفض طلب انضمام المتجر مع تسجيل السبب&#xa;(Reject Store Registration)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;fontColor=#B91C1C;fontStyle=1;fontSize=11;" vertex="1" parent="group_admin">
