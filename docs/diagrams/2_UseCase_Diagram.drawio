  <diagram id="UseCase_V2" name="Detailed Use Case Diagram">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="1100" background="#FFFFFF" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header -->
        <mxCell id="uc_header" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;مخطط حالات الاستخدام التفصيلي لمنظومة وَفِّر (Detailed Use Case Diagram)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;الأدوار والصلاحيات الواقعية: العميل (Consumer)، التاجر (Merchant)، ومدير النظام (System Admin)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#1E293B;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="175" y="20" width="1000" height="60" as="geometry" />
        </mxCell>

        <!-- System Boundary -->
